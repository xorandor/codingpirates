// -----------------------------------------------------------------------------
// Kopier denne fil til 'program.cs' og begynd at bygge dit spil.
// program.cs er DIN fil. Den kommer aldrig i git, saa du kan lave lige hvad du vil.
//
// Kor spillet:       dotnet run   (spillet sporger selv om du vil vaere vaert eller vaere med)
// 3D-visning:        F3 mens spillet koerer
// Spillerliste:      P viser og skjuler den
// -----------------------------------------------------------------------------

using Components;
using Kraken;
using Raylib_cs;
using System.Numerics;

var game = new GameEngine
{
    Title = "Mit Kraken-spil",
    Width = 1280,
    Height = 720,
    Background = Color.RayWhite,
    Network = true,   // spillet kan spilles sammen over netvaerket

    // Linjerne herunder er KUN til test - de springer alle skaermene over:
    //   dotnet run -- vaert [kode]                 (start direkte som vaert)
    //   dotnet run -- klient 127.0.0.1 Anna [kode] (forbind direkte, uden soegning)
    Mode = args.Contains("klient") ? GameMode.Client : args.Contains("vaert") ? GameMode.Server : null,
    ServerIp = args.Contains("klient") && args.Length > 1 ? args[1] : "",
    PlayerName = args.Length > 2 ? args[2] : "",
    Password = args.Contains("klient") ? (args.Length > 3 ? args[3] : "") : (args.Contains("vaert") && args.Length > 1 ? args[1] : "")
};

// Kameraet: y peger opad, og (0,0,0) er midt paa skaermen.
game.Camera.Height = 720;   // hvor mange world units der er plads til i hojden

// -----------------------------------------------------------------------------
// Klientens opslagsbog: naar serveren siger "moent", hvad skal klienten saa lave?
// Du behoever ikke have den samme kode som serveren - kender klienten ikke en slags,
// tegner den bare en graa kasse i stedet for at gaa ned.
// -----------------------------------------------------------------------------
game.NetworkKinds.Register("spiller", () => new Player());
game.NetworkKinds.Register("moent", () => new Coin());
game.NetworkKinds.Register("kugle", () => new CircleShooter.Bullet());
game.NetworkKinds.Register("kanon", () => new CircleShooter());
game.NetworkKinds.Register("ekstra-liv", () => new PowerBuffExtraHealth());
game.NetworkKinds.Register("magnet", () => new PowerBuffCoinMagnet());

// -----------------------------------------------------------------------------
// Skaerm og tal. De virker baade paa serveren og paa klienterne.
// -----------------------------------------------------------------------------
game.Add(new StartScreen { Title = "MOENTJAGT" });
game.Add(new GameOverScreen());
game.Add(new Score());
game.Add(new HighScore());
game.Add(new TagCounter { Tag = "moent", Label = "Monter tilbage" });
game.Add(new WinCondition { ScoreToWin = 100 });

// Et lys. Uden det tegnes alt fladt - proev at slette linjen og se forskellen.
game.Add(new Light());

// Lyd paa beskederne: samle op, tage skade, doe, vinde ... Ingen lydfiler - koden laver dem.
game.Add(new SoundEffects());

// -----------------------------------------------------------------------------
// Selve spillet. Paa en klient bliver alt med et NetworkKind droppet af motoren -
// serveren ejer det og sender det over. Saa det her kan staa her uden videre.
// -----------------------------------------------------------------------------
// En figur til hver spiller der forbinder sig - og en til dig selv.
game.Add(new NetworkPlayers
{
    HostName = "Mig",
    CreatePlayer = () => new Player { Speed = 320, MaxLives = 3 }
});

game.Add(new CircleShooter
{
    Position = new(0, 0, 0),
    AutoShootEverySeconds = 1.2f,
    MaxBounces = 4,
    BulletSpeed = 260
});

for (int i = 0; i < 12; i++)
{
    game.Add(new Coin
    {
        Position = new(Random.Shared.Next(-550, 550), Random.Shared.Next(-300, 300), 0),
        Value = 10
    });
}

game.Add(new PowerBuffExtraHealth { Position = new(-450, 250, 0) });
game.Add(new PowerBuffCoinMagnet { Position = new(450, -250, 0), Duration = 8f });

// Kom med en ny moent hvert andet sekund, saa banen aldrig loeber tor.
game.Add(new CoinSpawner());

// game.Password = "blaa-banan";   // fast kode paa spillet. Uden denne sporger vaert-skaermen selv.

game.Run();


// -----------------------------------------------------------------------------
// Du maa gerne skrive smaa komponenter direkte her i program.cs.
// Skal de bruges i flere spil, hoerer de hjemme i MyGames/.
// -----------------------------------------------------------------------------
class CoinSpawner : Component
{
    public override void OnAdded(GameContext context)
    {
        if (!context.IsServer) return;   // kun serveren maa lave moenter

        context.Every(2f, () => context.Add(new Coin
        {
            Position = new Vector3(Random.Shared.Next(-550, 550), Random.Shared.Next(-300, 300), 0),
            Value = 10
        }));
    }
}
