<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kraken</RootNamespace>
    <AssemblyName>Kraken</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>

  <!-- Billeder, modeller og lyde folger med ud i bin-mappen, saa Assets.Texture() kan finde dem. -->
  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Skabelonerne er hele spil med hver deres program.cs. De skal kunne LAESES, ikke
       kompileres - ellers braekker bygget paa to Main-metoder. Kopier dem ud for at bruge dem.
       None-linjen goer at filerne stadig kan SES (og kopieres) i Visual Studio. -->
  <ItemGroup>
    <Compile Remove="GameTemplates\**" />
    <None Include="GameTemplates\**\*.cs" />
  </ItemGroup>

</Project>
