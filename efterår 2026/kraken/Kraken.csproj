<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kraken</RootNamespace>
    <AssemblyName>Kraken</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.2" />
  </ItemGroup>

  <!-- Billeder, modeller og lyde folger med ud i bin-mappen, saa Assets.Texture() kan finde dem. -->
  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Skabelonerne er hele spil med hver deres program.cs. De er ikke en del af projektet:
       de maa ikke kompileres (to Main-metoder), og de skjules helt for Solution Explorer,
       saa ingen fristes til at kopiere dem DERINDE - VS-kopiering skriver linjer ind i denne
       fil, og kopien kompilerer saa ikke. Kopier dem ud med Stifinder, terminalen eller
       Claude. Laes dem i Stifinder, eller efter kopiering - saa ligger de i MyGames/. -->
  <ItemGroup>
    <Compile Remove="GameTemplates\**" />
    <None Remove="GameTemplates\**" />
  </ItemGroup>

  </Project>
